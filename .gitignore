__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local data (DB, media cache, exports)
data/
.env

# Claude Code: ignore by default, carve out the parts that codify project contracts
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/__pycache__/
